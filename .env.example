# For OpenRouter, use: https://openrouter.ai/keys
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini

# Optional integrations (use your own; do not commit real URLs or tokens)
SLACK_WEBHOOK_URL=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# Closed-issue → KB sync (scripts/sync_closed_jira_to_kb.py). Override default JQL if needed.
# JIRA_JQL_CLOSED=project = YOURPROJ AND statusCategory = Done AND updated >= -30d ORDER BY updated DESC
# JIRA_KB_PROCESSED_FILE=data/jira_kb_processed.json

# Vector DB (RAG). Indexed by sync script; remediation retrieves automatically when embeddings work.
# CHROMA_PERSIST_DIR=data/chroma
# CHROMA_COLLECTION_NAME=incident_resolutions
# EMBEDDING_MODEL=text-embedding-3-small
# RAG_TOP_K=5

# Presidio log anonymization (optional overrides)
# PRESIDIO_DISABLE=false
# Set to true to keep raw IPs (e.g. for on-call triage)
# PRESIDIO_KEEP_IP=false
# Set to true to keep DNS / server-style hostnames
# PRESIDIO_KEEP_HOSTNAMES=false
# PRESIDIO_ENTITIES=EMAIL_ADDRESS,IP_ADDRESS,SERVER_HOSTNAME,...
# PRESIDIO_MAX_CHUNK_CHARS=50000
# PRESIDIO_SPACY_MODEL=en_core_web_sm
